// Relais WebSocket + hébergement de la PWA, en un seul Worker.
{
  "name": "pastille",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../pwa/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
